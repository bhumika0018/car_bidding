# ================================================
# Car_Sell Environment Configuration Reference
# ================================================
# Rename or copy this file to .env for local runtime customization.
# Do NOT commit actual passwords or private keys to source control.

# Database Credentials
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# Authentication & Security
# Base64 encoded 256-bit secret key for JWT signing
JWT_SECRET=aGVsbG9Xb3JsZDMyYnl0ZXNlY3JldGtleWZvcmNhcnNhbGVhcHAxMjM=

# Microservices URLs
AUTH_SERVICE_URL=http://localhost:8081
EUREKA_SERVER_URL=http://localhost:8761/eureka/
